---
import { withBase } from '../lib/paths';

interface Panel {
  src: string;
  alt: string;
}

interface Props {
  panels?: Panel[];
}

const { panels = [] } = Astro.props;

const resolvedPanels = panels.map((panel) => ({
  ...panel,
  src: panel.src.startsWith('/') ? withBase(panel.src.replace(/^\/+/, '')) : panel.src,
}));

const hasPanels = resolvedPanels.length > 0;
---

<div class="story-reader" data-story-reader data-mode="classic">
  <div class="story-reader__controls">
    <p class="story-reader__label" id="reader-mode-label">Reading mode</p>
    <div class="story-reader__switch" role="group" aria-labelledby="reader-mode-label">
      <button type="button" class="story-reader__mode" data-reader-mode="cinematic" aria-pressed="false">
        Cinematic
      </button>
      <button type="button" class="story-reader__mode" data-reader-mode="classic" aria-pressed="true">
        Classic
      </button>
    </div>
  </div>

  <div class="story-reader__stage" data-reader-stage>
    <div class="story-reader__prose prose" data-reader-prose>
      <slot />
    </div>

    {
      hasPanels &&
        resolvedPanels.map((panel) => (
          <figure class="story-reader__panel" data-reader-block>
            <img src={panel.src} alt={panel.alt} loading="lazy" decoding="async" />
          </figure>
        ))
    }
  </div>
</div>

<style>
  .story-reader__controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    max-width: var(--measure);
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .story-reader__label {
    margin: 0;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .story-reader__switch {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--color-surface) 60%, transparent);
  }

  .story-reader__mode {
    padding: 0.4rem 0.95rem;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: transparent;
    color: var(--color-muted);
    font-family: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .story-reader__mode:hover {
    color: var(--color-text);
  }

  .story-reader__mode[aria-pressed="true"] {
    color: var(--color-text);
    background-color: var(--color-primary-soft);
  }

  /* Prose stays on the readable measure; panels span the container. */
  .story-reader__prose {
    max-width: var(--measure);
    margin-inline: auto;
  }

  /* Panels keep their original proportions — no cropping. */
  .story-reader__panel {
    margin: 0 0 var(--space-2xl);
  }

  .story-reader__panel img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Cinematic reveal (only when JS enables it and motion is allowed). */
  .story-reader[data-mode="cinematic"] [data-reveal] {
    opacity: 0;
    transform: translateY(1.25rem);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
  }

  .story-reader[data-mode="cinematic"] [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .story-reader [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'unrealyria:reader-mode';
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const supportsObserver = 'IntersectionObserver' in window;

  // Preference persistence — safe if storage is blocked/unavailable.
  const readStoredMode = (): string | null => {
    try {
      const value = window.localStorage.getItem(STORAGE_KEY);
      return value === 'cinematic' || value === 'classic' ? value : null;
    } catch {
      return null;
    }
  };

  const storeMode = (mode: string) => {
    try {
      window.localStorage.setItem(STORAGE_KEY, mode);
    } catch {
      /* storage unavailable — ignore */
    }
  };

  document.querySelectorAll('[data-story-reader]').forEach((node) => {
    if (!(node instanceof HTMLElement)) return;
    const stage = node.querySelector('[data-reader-stage]');
    if (!(stage instanceof HTMLElement)) return;

    const modeButtons = node.querySelectorAll('[data-reader-mode]');
    let observer: IntersectionObserver | null = null;

    // Reveal every prose block *and* every panel, rather than the whole body.
    const collectBlocks = (): HTMLElement[] => {
      const prose = stage.querySelector('[data-reader-prose]');
      const proseBlocks = prose ? (Array.from(prose.children) as HTMLElement[]) : [];
      const panels = Array.from(stage.querySelectorAll('[data-reader-block]')) as HTMLElement[];
      return [...proseBlocks, ...panels];
    };

    const teardown = () => {
      if (observer) {
        observer.disconnect();
        observer = null;
      }
    };

    const setMode = (mode: string, persist: boolean) => {
      node.setAttribute('data-mode', mode);
      modeButtons.forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          String(button.getAttribute('data-reader-mode') === mode),
        );
      });

      teardown();
      const blocks = collectBlocks();

      // Reveal only with motion allowed *and* an observer available; otherwise
      // everything stays visible (no content hidden without JS/observer).
      const animate = mode === 'cinematic' && !reduceMotion.matches && supportsObserver;

      if (animate) {
        blocks.forEach((block) => block.setAttribute('data-reveal', ''));
        observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        blocks.forEach((block) => observer?.observe(block));
      } else {
        blocks.forEach((block) => {
          block.removeAttribute('data-reveal');
          block.classList.add('is-visible');
        });
      }

      if (persist) {
        storeMode(mode);
      }
    };

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setMode(button.getAttribute('data-reader-mode') ?? 'cinematic', true);
      });
    });

    reduceMotion.addEventListener('change', () => {
      setMode(reduceMotion.matches ? 'classic' : (readStoredMode() ?? 'cinematic'), false);
    });

    const initial = reduceMotion.matches ? 'classic' : (readStoredMode() ?? 'cinematic');
    setMode(initial, false);
  });
</script>
