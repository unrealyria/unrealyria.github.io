---
import { resolveArt } from '../lib/art';
import type { Chapter, Saga } from '../lib/cms/types';
import { chapterPath, chapterSlug, sagaPath } from '../lib/paths';
import { themeToCssVars } from '../lib/theme';

interface Props {
  saga: Saga;
  chapter?: Chapter;
  eyebrow?: string;
  priority?: boolean;
}

const { saga, chapter, eyebrow = 'Featured saga', priority = false } = Astro.props;

const imageAlt = saga.data.imageAlt ?? `Key visual for ${saga.data.title}.`;
const resolvedImage = resolveArt(saga.data.image);

const ctaLabel =
  chapter && chapter.data.number === 1
    ? 'Start Chapter 01'
    : chapter
      ? `Read Chapter ${String(chapter.data.number).padStart(2, '0')}`
      : 'Enter the saga';
---

<section class="saga-feature" style={themeToCssVars(saga.data.theme)}>
  <div class="saga-feature__backdrop" aria-hidden={resolvedImage ? undefined : 'true'}>
    {
      resolvedImage ? (
        <img
          class="saga-feature__image"
          src={resolvedImage}
          alt={imageAlt}
          width="1600"
          height="900"
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="saga-feature__atmos" />
      )
    }
    <div class="saga-feature__scrim" aria-hidden="true" />
  </div>

  <div class="container saga-feature__inner">
    <div class="saga-feature__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="saga-feature__title display">{saga.data.title}</h2>
      <p class="saga-feature__summary">{saga.data.summary}</p>
      {
        saga.data.tags.length > 0 && (
          <ul class="tag-list saga-feature__tags" aria-label="Tags">
            {saga.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      <div class="saga-feature__actions">
        {
          chapter && (
            <a class="btn btn--primary" href={chapterPath(saga.id, chapterSlug(chapter.id))}>
              {ctaLabel} <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          )
        }
        <a class="btn btn--ghost" href={sagaPath(saga.id)}>View saga</a>
      </div>
    </div>
  </div>
</section>

<style>
  .saga-feature {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-block: 1px solid var(--color-border);
  }

  .saga-feature__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .saga-feature__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .saga-feature__atmos {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        65% 80% at 80% 20%,
        color-mix(in srgb, var(--color-primary) 40%, transparent),
        transparent 62%
      ),
      radial-gradient(
        55% 70% at 10% 92%,
        color-mix(in srgb, var(--color-accent) 22%, transparent),
        transparent 60%
      ),
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--color-text) 3.5%, transparent) 0 1px,
        transparent 1px 60px
      );
  }

  .saga-feature__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        color-mix(in srgb, var(--color-bg) 90%, transparent) 0%,
        color-mix(in srgb, var(--color-bg) 66%, transparent) 46%,
        transparent 82%
      ),
      linear-gradient(to top, color-mix(in srgb, var(--color-bg) 78%, transparent), transparent 55%);
  }

  .saga-feature__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 2rem + 9vw, 7rem);
  }

  .saga-feature__copy {
    max-width: 44rem;
  }

  .saga-feature__title {
    margin: 0;
    font-size: var(--step-4);
  }

  .saga-feature__summary {
    margin: var(--space-md) 0 0;
    color: color-mix(in srgb, var(--color-text) 84%, var(--color-muted));
    font-size: var(--step-1);
    max-width: 46ch;
    text-wrap: pretty;
  }

  .saga-feature__tags {
    margin-top: var(--space-md);
  }

  .saga-feature__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  @media (max-width: 30rem) {
    .saga-feature__actions .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
</style>
