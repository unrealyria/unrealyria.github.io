---
import type { MusicTrack } from '../lib/cms/types';
import { resolveArt } from '../lib/art';

interface Props {
  track: MusicTrack;
}

const { track } = Astro.props;

const { title, credits, mood, durationSeconds, artwork, artworkAlt, youtubeUrl, streamingLinks } =
  track.data;

function formatDuration(seconds?: number): string | undefined {
  if (!seconds) {
    return undefined;
  }
  const minutes = Math.floor(seconds / 60);
  const remainder = seconds % 60;
  return `${minutes}:${String(remainder).padStart(2, '0')}`;
}

const duration = formatDuration(durationSeconds);
const metaLine = [credits, mood, duration].filter(Boolean).join(' · ');
const resolvedArtwork = resolveArt(artwork);

// Provider-agnostic iconography. Providers are typed in the music schema; the
// label always carries the meaning, icons are decorative.
const PROVIDER_ICONS: Record<string, string> = {
  youtube:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="M10.5 9.5l4.5 2.5-4.5 2.5z" fill="currentColor" stroke="none"/></svg>',
  audiocom:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><path d="M4 14h3v6H5a1 1 0 0 1-1-1z"/><path d="M20 14h-3v6h2a1 1 0 0 0 1-1z"/></svg>',
  soundcloud:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 14v3M6.5 11.5v6M9 9.5v8M11.5 10.5v7"/><path d="M14.5 12.5h3.2a2.3 2.3 0 0 1 0 4.5h-3.2z"/></svg>',
  spotify:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M7.5 9.5c3-.8 6.2-.4 8.8 1.2M8.2 12.6c2.4-.6 5-.3 7 .9M8.9 15.5c1.8-.4 3.7-.2 5.2.7"/></svg>',
  applemusic:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V6l10-2v12"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/></svg>',
  bandcamp:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-6 4 12 3-6h4"/></svg>',
  other:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 5h5v5"/><path d="M19 5l-8 8"/><path d="M19 14v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4"/></svg>',
};

const PROVIDER_ORDER = ['youtube', 'audiocom', 'soundcloud', 'spotify', 'applemusic', 'bandcamp'];

// Only genuinely configured providers are shown.
const providers = [...streamingLinks]
  .filter((link) => Boolean(link.url))
  .sort((a, b) => {
    const ai = PROVIDER_ORDER.indexOf(a.provider ?? 'other');
    const bi = PROVIDER_ORDER.indexOf(b.provider ?? 'other');
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
  })
  .map((link) => ({
    ...link,
    icon: PROVIDER_ICONS[link.provider ?? 'other'] ?? PROVIDER_ICONS.other,
  }));

const playIcon =
  '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>';
---

<section class="music-hub" aria-labelledby="music-hub-title">
  <div class="container">
    <div class="music-hub__panel">
      <figure class="music-hub__art">
        {
          resolvedArtwork ? (
            <img
              src={resolvedArtwork}
              alt={artworkAlt ?? `${title} cover artwork`}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="music-hub__art-fallback" aria-hidden="true" />
          )
        }
      </figure>

      <div class="music-hub__body">
        <p class="eyebrow music-hub__eyebrow">Chapter theme</p>
        <h2 id="music-hub-title" class="music-hub__title display">{title}</h2>
        {metaLine && <p class="music-hub__meta">{metaLine}</p>}

        {
          youtubeUrl && (
            <div class="music-hub__actions">
              <a
                class="btn btn--primary"
                href={youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="music-hub__play" set:html={playIcon} />
                Watch the Music Video <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          )
        }

        {
          providers.length > 0 && (
            <div class="music-hub__listen">
              <p class="music-hub__listen-label">Listen on</p>
              <ul class="music-hub__providers">
                {providers.map((provider) => (
                  <li>
                    <a
                      class="music-hub__provider"
                      href={provider.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="music-hub__provider-icon" set:html={provider.icon} />
                      {provider.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Vertical rhythm is owned by the chapter body layout, not the component. */
  .music-hub {
    margin: 0;
  }

  .music-hub__panel {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
    align-items: center;
    padding: clamp(1.25rem, 0.75rem + 2.5vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
    box-shadow: var(--shadow-md);
  }

  .music-hub__art {
    margin: 0;
    width: min(100%, 18rem);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-accent) 26%, transparent);
    border-radius: var(--radius-md);
    background: var(--gradient-surface);
  }

  .music-hub__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .music-hub__art-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--gradient-primary);
    opacity: 0.4;
  }

  .music-hub__eyebrow {
    color: var(--color-accent);
  }

  .music-hub__title {
    margin: 0 0 var(--space-2xs);
    font-size: var(--step-3);
    text-wrap: balance;
  }

  .music-hub__meta {
    margin: 0 0 var(--space-md);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .music-hub__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .music-hub__play {
    display: inline-flex;
  }

  .music-hub__play svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .music-hub__listen {
    margin-top: var(--space-lg);
  }

  .music-hub__listen-label {
    margin: 0 0 var(--space-xs);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .music-hub__providers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .music-hub__provider {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-size: var(--step--1);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .music-hub__provider:hover {
    border-color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .music-hub__provider-icon {
    display: inline-flex;
  }

  .music-hub__provider-icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (min-width: 48rem) {
    .music-hub__panel {
      grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    }

    .music-hub__art {
      width: 100%;
    }
  }

  @media (max-width: 30rem) {
    .music-hub__actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
