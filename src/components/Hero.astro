---
import { getImage } from 'astro:assets';
import { resolveArt } from '../lib/art';
import { themeToCssVars, type SagaTheme } from '../lib/theme';

interface Props {
  title: string;
  eyebrow?: string;
  tagline?: string;
  variant?: 'cinematic' | 'panorama';
  theme?: SagaTheme;
  image?: string | ImageMetadata;
  imageAlt?: string;
  imageMobile?: string | ImageMetadata;
  align?: 'start' | 'end';
  focus?: string;
  focusMobile?: string;
  // Stacks the artwork above the copy below the large-desktop breakpoint so the
  // text never overlaps the focal subject. Used by saga key-art heroes.
  stacked?: boolean;
}

const {
  title,
  eyebrow,
  tagline,
  variant = 'cinematic',
  theme,
  image,
  imageAlt,
  imageMobile,
  align = 'start',
  focus,
  focusMobile,
  stacked = false,
} = Astro.props;

const hasActions = Astro.slots.has('actions');
const styleVars =
  [
    theme ? themeToCssVars(theme) : undefined,
    focus ? `--hero-focus: ${focus}` : undefined,
    focusMobile ? `--hero-focus-mobile: ${focusMobile}` : undefined,
  ]
    .filter(Boolean)
    .join('; ') || undefined;

// Imported assets (ImageMetadata) go through the Astro image pipeline for
// AVIF/WebP responsive delivery; plain strings keep the legacy public-path
// behaviour used by saga pages.
function isLocalAsset(value: unknown): value is ImageMetadata {
  return (
    typeof value === 'object' &&
    value !== null &&
    'src' in value &&
    'width' in value &&
    'height' in value &&
    'format' in value
  );
}

const desktopImage = isLocalAsset(image) ? image : undefined;
const mobileImage = isLocalAsset(imageMobile) ? imageMobile : undefined;
const stringImage = desktopImage
  ? undefined
  : resolveArt(typeof image === 'string' ? image : undefined);

// Full-bleed art direction: panorama from tablet up, vertical art on phones.
const HERO_SIZES = '100vw';
const DESKTOP_WIDTHS = [640, 960, 1280, 1672];
const MOBILE_WIDTHS = [360, 480, 640, 828, 941];

const desktopSources = desktopImage
  ? await Promise.all([
      getImage({
        src: desktopImage,
        format: 'avif',
        widths: DESKTOP_WIDTHS,
        sizes: HERO_SIZES,
        quality: 68,
      }),
      getImage({
        src: desktopImage,
        format: 'webp',
        widths: DESKTOP_WIDTHS,
        sizes: HERO_SIZES,
        quality: 74,
      }),
    ])
  : null;

const mobileSources = mobileImage
  ? await Promise.all([
      getImage({
        src: mobileImage,
        format: 'avif',
        widths: MOBILE_WIDTHS,
        sizes: HERO_SIZES,
        quality: 68,
      }),
      getImage({
        src: mobileImage,
        format: 'webp',
        widths: MOBILE_WIDTHS,
        sizes: HERO_SIZES,
        quality: 74,
      }),
    ])
  : null;

const [desktopAvif, desktopWebp] = desktopSources ?? [];
const [mobileAvif, mobileWebp] = mobileSources ?? [];

// Intrinsic dimensions for the <img>. Read from the getImage result rather than
// the imported image object: reading a property off the import marks the asset
// as "externally referenced" and makes Astro copy the full-resolution original
// into the build output.
const desktopWidth = desktopWebp?.options.width ?? 1600;
const desktopHeight = desktopWebp?.options.height ?? 900;
---

<section
  class:list={[
    'hero',
    `hero--${variant}`,
    desktopImage ? 'hero--photo' : undefined,
    desktopImage ? `hero--align-${align}` : undefined,
    mobileImage ? 'hero--mobile-art' : undefined,
    stacked ? 'hero--stack' : undefined,
  ]}
  style={styleVars}
>
  <div class="hero__backdrop">
    {
      desktopImage && desktopWebp ? (
        <picture class="hero__picture">
          {mobileAvif && (
            <source
              type="image/avif"
              media="(max-width: 47.9375rem)"
              srcset={mobileAvif.srcSet.attribute}
              sizes={HERO_SIZES}
            />
          )}
          {mobileWebp && (
            <source
              type="image/webp"
              media="(max-width: 47.9375rem)"
              srcset={mobileWebp.srcSet.attribute}
              sizes={HERO_SIZES}
            />
          )}
          {desktopAvif && (
            <source type="image/avif" srcset={desktopAvif.srcSet.attribute} sizes={HERO_SIZES} />
          )}
          <source type="image/webp" srcset={desktopWebp.srcSet.attribute} sizes={HERO_SIZES} />
          <img
            class="hero__image"
            src={desktopWebp.src}
            alt={imageAlt ?? ''}
            width={desktopWidth}
            height={desktopHeight}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      ) : stringImage ? (
        <img
          class="hero__image"
          src={stringImage}
          alt={imageAlt ?? ''}
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
        <div class="hero__atmos" aria-hidden="true"></div>
      )
    }
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="container container--wide hero__inner">
    <div class="hero__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="hero__title">{title}</h1>
      {tagline && <p class="hero__tagline lede">{tagline}</p>}
      {hasActions && <div class="hero__actions"><slot name="actions" /></div>}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__picture {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero__atmos {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        70% 80% at 18% 16%,
        color-mix(in srgb, var(--color-primary) 34%, transparent),
        transparent 62%
      ),
      radial-gradient(
        60% 70% at 88% 6%,
        color-mix(in srgb, var(--color-accent) 20%, transparent),
        transparent 58%
      ),
      radial-gradient(
        120% 90% at 50% 120%,
        color-mix(in srgb, var(--color-primary) 16%, transparent),
        transparent 60%
      ),
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--color-text) 3.5%, transparent) 0 1px,
        transparent 1px 64px
      );
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        color-mix(in srgb, var(--color-bg) 88%, transparent) 0%,
        color-mix(in srgb, var(--color-bg) 62%, transparent) 42%,
        transparent 78%
      ),
      linear-gradient(to top, color-mix(in srgb, var(--color-bg) 82%, transparent), transparent 45%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(3.25rem, 2rem + 9vw, 7.5rem);
  }

  .hero--panorama .hero__inner {
    padding-block: clamp(3.5rem, 2rem + 12vw, 9rem);
  }

  .hero__copy {
    max-width: 46rem;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.02em;
    font-size: var(--step-5);
    text-wrap: balance;
  }

  .hero--cinematic .hero__title {
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .hero--panorama .hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-4);
    max-width: 22ch;
  }

  .hero__tagline {
    margin: var(--space-md) 0 0;
    max-width: 42ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  @media (max-width: 30rem) {
    .hero__actions .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
  }

  /* --- Responsive artwork hero (brand / saga key art) ------------------- */

  /* Tablet and up: the copy sits low by default and the lower band is scrimmed
     for readable contrast. The focal subject is kept opposite the copy. */
  .hero--photo .hero__inner {
    display: flex;
    align-items: flex-end;
    min-height: clamp(30rem, 66vh, 44rem);
  }

  .hero--photo .hero__copy {
    max-width: 38rem;
  }

  /* Default art direction: focal subject on the left, copy on the right. */
  .hero--photo .hero__image {
    object-position: var(--hero-focus, left 30%);
  }

  .hero--photo .hero__scrim {
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--color-bg) 90%, transparent) 0%,
        color-mix(in srgb, var(--color-bg) 62%, transparent) 38%,
        transparent 66%
      ),
      linear-gradient(to right, color-mix(in srgb, var(--color-bg) 58%, transparent), transparent 48%);
  }

  /* Brand art direction: focal subject on the right, copy on the left. */
  .hero--align-start.hero--photo .hero__image {
    object-position: var(--hero-focus, right 32%);
  }

  /* The scrim itself follows the copy side at each breakpoint (see the
     tablet default below, plus the ≥1280px and ≤767px overrides), so it always
     protects the text and never darkens the focal subject. */

  /* Desktop ≥1280px: full-bleed panoramic artwork with the copy on one side. */
  @media (min-width: 80rem) {
    .hero--align-end .hero__inner {
      align-items: center;
      justify-content: flex-end;
    }

    .hero--align-end .hero__copy {
      max-width: 36rem;
    }

    .hero--align-end .hero__scrim {
      background:
        linear-gradient(
          260deg,
          color-mix(in srgb, var(--color-bg) 92%, transparent) 0%,
          color-mix(in srgb, var(--color-bg) 66%, transparent) 44%,
          transparent 82%
        ),
        linear-gradient(
          to top,
          color-mix(in srgb, var(--color-bg) 78%, transparent),
          transparent 48%
        );
    }

    .hero--align-start .hero__inner {
      align-items: center;
      justify-content: flex-start;
    }

    .hero--align-start .hero__copy {
      max-width: 40rem;
    }

    .hero--align-start .hero__scrim {
      background:
        linear-gradient(
          100deg,
          color-mix(in srgb, var(--color-bg) 95%, transparent) 0%,
          color-mix(in srgb, var(--color-bg) 74%, transparent) 38%,
          transparent 78%
        ),
        linear-gradient(
          to top,
          color-mix(in srgb, var(--color-bg) 72%, transparent),
          transparent 46%
        );
    }
  }

  /* Phones ≤767px: dedicated vertical artwork when supplied, otherwise the
     16:9 art is cropped to keep the focal subject visible. The copy is anchored
     to the bottom with a strong lower scrim. */
  @media (max-width: 47.9375rem) {
    .hero--photo .hero__inner {
      min-height: clamp(32rem, 82vh, 46rem);
    }

    /* Vertical artwork: keep the face/upper body in view. */
    .hero--photo .hero__image {
      object-position: var(--hero-focus-mobile, center 30%);
    }

    /* Fallback when only a 16:9 asset is available: crop to the right subject. */
    .hero--align-start.hero--photo:not(.hero--mobile-art) .hero__image {
      object-position: var(--hero-focus-mobile, 82% 16%);
    }

    .hero--photo .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero--photo .hero__actions .btn {
      width: 100%;
      justify-content: center;
    }

    .hero--photo .hero__scrim {
      background:
        linear-gradient(
          to top,
          color-mix(in srgb, var(--color-bg) 94%, transparent) 0%,
          color-mix(in srgb, var(--color-bg) 72%, transparent) 32%,
          transparent 64%
        ),
        linear-gradient(
          to bottom,
          color-mix(in srgb, var(--color-bg) 52%, transparent),
          transparent 28%
        );
    }
  }

  /* Stacked artwork (saga key art below large desktop): the image owns its own
     block and the copy flows underneath, so the text can never cover the focal
     subject. Above the breakpoint the cinematic overlay above still applies. */
  @media (max-width: 79.9375rem) {
    .hero--stack .hero__backdrop {
      position: relative;
      inset: auto;
    }

    .hero--stack .hero__picture {
      position: relative;
      inset: auto;
    }

    .hero--stack .hero__image {
      height: auto;
    }

    /* Only a soft fade at the foot of the artwork blends it into the copy. */
    .hero--stack .hero__scrim {
      background: linear-gradient(
        to top,
        var(--color-bg) 1%,
        color-mix(in srgb, var(--color-bg) 58%, transparent) 24%,
        transparent 56%
      );
    }

    .hero--stack .hero__inner {
      display: block;
      min-height: 0;
      padding-block: clamp(1.75rem, 1rem + 3vw, 3rem) clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    }

    .hero--stack .hero__copy {
      max-width: 42rem;
    }
  }
</style>
