---
import { Picture } from 'astro:assets';

interface Props {
  href: string;
  label: string;
  description: string;
  art: ImageMetadata;
}

const { href, label, description, art } = Astro.props;
---

<li class="explore-card">
  <a class="explore-card__link" href={href}>
    <span class="explore-card__media" aria-hidden="true">
      <Picture
        src={art}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[360, 640, 960]}
        sizes="(min-width: 64rem) 21rem, (min-width: 36rem) 45vw, 100vw"
        alt=""
        loading="lazy"
        decoding="async"
        class="explore-card__image"
      />
    </span>
    <span class="explore-card__overlay" aria-hidden="true"></span>
    <div class="explore-card__content">
      <h3 class="explore-card__label">{label}</h3>
      <p class="explore-card__desc">{description}</p>
    </div>
    <span class="explore-card__arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14" />
        <path d="m13 6 6 6-6 6" />
      </svg>
    </span>
  </a>
</li>

<style>
  .explore-card {
    display: flex;
  }

  .explore-card__link {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--aaaa-border);
    border-radius: var(--aaaa-radius);
    background: var(--aaaa-bg);
    color: var(--color-text);
    text-decoration: none;
    isolation: isolate;
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .explore-card__link:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--aaaa-gold) 55%, transparent);
    box-shadow: var(--shadow-lg);
  }

  .explore-card__media {
    position: absolute;
    inset: 0;
  }

  .explore-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transition: transform var(--dur) var(--ease);
  }

  .explore-card__link:hover .explore-card__image {
    transform: scale(1.04);
  }

  .explore-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--aaaa-bg) 92%, transparent) 4%,
      color-mix(in srgb, var(--aaaa-bg) 42%, transparent) 46%,
      transparent 78%
    );
  }

  .explore-card__content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: clamp(1rem, 0.7rem + 1vw, 1.5rem);
    padding-inline-end: 3.9rem;
  }

  .explore-card__label {
    margin: 0;
    font-family: var(--aaaa-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1;
  }

  .explore-card__desc {
    margin: 0;
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--color-text) 80%, var(--color-muted));
    text-wrap: pretty;
  }

  .explore-card__arrow {
    position: absolute;
    right: clamp(1rem, 0.7rem + 1vw, 1.5rem);
    bottom: clamp(1rem, 0.7rem + 1vw, 1.5rem);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--aaaa-gold) 60%, transparent);
    color: var(--aaaa-gold);
    background: color-mix(in srgb, var(--aaaa-bg) 45%, transparent);
  }

  .explore-card__arrow svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .explore-card__link:hover .explore-card__image {
      transform: none;
    }
  }
</style>
