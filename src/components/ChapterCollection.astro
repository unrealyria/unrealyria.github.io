---
import path from 'node:path';
import { discoverComicCollections } from '../lib/comic';
import { withBase } from '../lib/paths';

interface Props {
  srcDir: string;
  readerId: string;
}
const { srcDir, readerId } = Astro.props;
const collections = discoverComicCollections(path.join(process.cwd(), 'public'), srcDir);
---

{collections.length > 0 && (
  <section class="collection" aria-labelledby={`${readerId}-collection-heading`}>
    <header>
      <p class="eyebrow">Official Collection</p>
      <h2 id={`${readerId}-collection-heading`} class="display">Collect the Chapter</h2>
    </header>
    <ul class="collection__editions">
      {collections.map((collection) => (
        <li class="collection__edition">
          <img
            class="collection__thumbnail"
            src={withBase(`${collection.directory.replace(/^\/+/, '')}/${collection.pages[0].name}`)}
            width={collection.pages[0].width}
            height={collection.pages[0].height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div class="collection__details">
            <h3>{collection.label}</h3>
            <p>{collection.pages.length} {collection.pages.length === 1 ? 'page' : 'pages'} <span aria-hidden="true">·</span> Online Reader</p>
          </div>
          <a class="btn btn--ghost" href={`#${readerId}`} data-read-collection={collection.id} data-reader-id={readerId}>
            Read Online <span class="visually-hidden">— {collection.label}</span> <span aria-hidden="true">↑</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-read-collection]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const reader = document.getElementById(link.dataset.readerId ?? '');
      const select = reader?.querySelector<HTMLSelectElement>('[data-comic-select]');
      if (select && !select.disabled && Array.from(select.options).some((option) => option.value === link.dataset.readCollection)) {
        select.value = link.dataset.readCollection!;
        select.dispatchEvent(new Event('change', { bubbles: true }));
      }
      reader?.querySelector<HTMLElement>('[data-comic-viewport]')?.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .collection { padding-block: clamp(1.5rem, 3vw, 2.5rem); }
  .eyebrow { margin: 0 0 .65rem; color: var(--color-muted); font-size: var(--step--1); letter-spacing: .18em; text-transform: uppercase; }
  h2 { margin: 0; font-size: var(--step-3); }
  .collection__editions { display: grid; gap: 1rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .collection__edition { display: grid; grid-template-columns: 10rem minmax(0, 1fr) auto; align-items: center; gap: 1.5rem; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: linear-gradient(110deg, var(--color-primary-soft), transparent 65%), var(--gradient-surface); }
  .collection__thumbnail { display: block; width: 100%; height: auto; max-height: 8rem; object-fit: contain; border-radius: var(--radius-sm); }
  h3 { margin: 0; font-size: var(--step-1); font-weight: 600; }
  .collection__edition p { margin: .35rem 0 0; color: var(--color-muted); font-size: var(--step--1); }
  .collection__edition a { justify-content: center; min-height: 44px; color: var(--color-text); border-color: color-mix(in srgb, var(--color-primary) 55%, var(--color-border)); background: var(--color-primary-soft); }
  @media (max-width: 48rem) {
    .collection { padding-block: 1rem 1.5rem; }
    .collection__editions { margin-top: 1.1rem; }
    .collection__edition { grid-template-columns: 6.5rem minmax(0, 1fr); column-gap: 1rem; row-gap: .75rem; padding: 1rem; }
    .collection__thumbnail { grid-row: 1 / 3; }
    .collection__edition a { grid-column: 2; justify-self: start; padding: .6rem .85rem; font-size: var(--step--1); }
    .collection__edition p { line-height: 1.6; }
  }
  @media (prefers-reduced-motion: reduce) {
    .collection__edition a { transition: none; transform: none; }
  }
</style>
