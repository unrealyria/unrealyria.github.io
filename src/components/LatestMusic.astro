---
import type { MusicTrack, Saga } from '../lib/cms/types';
import { musicPath, sagaPath } from '../lib/paths';

interface Props {
  track: MusicTrack;
  saga?: Saga;
}

const { track, saga } = Astro.props;

function formatDuration(seconds?: number): string | undefined {
  if (!seconds) {
    return undefined;
  }
  const minutes = Math.floor(seconds / 60);
  const remainder = seconds % 60;
  return `${minutes}:${String(remainder).padStart(2, '0')}`;
}

const { title, credits, mood, durationSeconds, artwork, artworkAlt, youtubeUrl } = track.data;
const duration = formatDuration(durationSeconds);
const meta = [credits, mood, duration].filter(Boolean).join(' · ');
---

<section
  id="latest-music"
  class="latest"
  aria-labelledby="latest-heading"
  style={artwork ? `--latest-cover: url('${artwork}')` : undefined}
>
  {/* Keep the official artwork sharp; contrast is supplied by local gradients. */}
  <div class="latest__bg" aria-hidden="true"></div>
  <div class="latest__overlay" aria-hidden="true"></div>

  <div class="aaaa-container latest__inner">
    <header class="latest__head">
      <p class="aaaa-eyebrow">Latest Music</p>
      <h2 id="latest-heading" class="latest__lede">The sound of a world waiting to be discovered.</h2>
      <p class="latest__description">
        Original music from UnreaLyria, where stories, emotions and imagined worlds come together in a unique journey.
      </p>
    </header>

    <div class="latest__grid">
      {
        artwork && (
          <figure class="latest__cover-wrap">
            <img
              class="latest__cover"
              src={artwork}
              alt={artworkAlt ?? `${title} artwork`}
              width="1254"
              height="1254"
              loading="lazy"
              decoding="async"
            />
          </figure>
        )
      }

      <div class="latest__info">
        <h3 class="latest__track">{title}</h3>
        {meta && <p class="latest__meta">{meta}</p>}
        {
          saga && (
            <p class="latest__saga">
              From <a href={sagaPath(saga.id)}>{saga.data.title}</a>
            </p>
          )
        }
        <div class="latest__actions">
          {
            youtubeUrl && (
              <a
                class="btn btn--primary"
                href={youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="latest__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </span>
                Watch on YouTube <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            )
          }
          <a class="btn btn--ghost" href={musicPath()}>
            <span class="latest__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 14v-2a8 8 0 0 1 16 0v2" />
                <path d="M4 14h3v6H5a1 1 0 0 1-1-1z" />
                <path d="M20 14h-3v6h2a1 1 0 0 0 1-1z" />
              </svg>
            </span>
            Explore the Music
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .latest {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2rem, 3vw, 3rem);
    scroll-margin-top: 6rem;
    background: var(--aaaa-bg);
  }

  /* A proportional crop of the CMS cover, separate from the foreground cover.
     The right-hand scene retains LYRIA and the citadel without image filters. */
  .latest__bg {
    position: absolute;
    inset: 0 0 0 34%;
    z-index: 0;
    background-image: var(--latest-cover);
    background-position: center 42%;
    background-size: cover;
    background-repeat: no-repeat;
    pointer-events: none;
  }

  .latest__overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(
        to bottom,
        var(--aaaa-bg), transparent 14%,
        transparent calc(100% - clamp(3rem, 6vw, 6rem)),
        color-mix(in srgb, var(--aaaa-bg) 45%, transparent) calc(100% - clamp(1.5rem, 3vw, 3rem)),
        color-mix(in srgb, var(--aaaa-bg) 95%, transparent)
      ),
      linear-gradient(
        to right,
        var(--aaaa-bg) 22%,
        color-mix(in srgb, var(--aaaa-bg) 94%, transparent) 36%,
        color-mix(in srgb, var(--aaaa-bg) 72%, transparent) 52%,
        color-mix(in srgb, var(--aaaa-bg) 16%, transparent) 76%,
        transparent
      );
    pointer-events: none;
  }

  .latest__inner {
    position: relative;
    z-index: 1;
  }

  .latest__head {
    max-width: 35rem;
    margin-bottom: clamp(1.25rem, 2vw, 2rem);
  }

  .latest__head .aaaa-eyebrow {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .latest__head .aaaa-eyebrow::after {
    content: '';
    width: 7rem;
    height: 1px;
    background: linear-gradient(to right, var(--aaaa-gold-line), transparent);
  }

  .latest__lede {
    margin: 0;
    font-family: var(--aaaa-display);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.01em;
    font-size: clamp(1.7rem, 1.2rem + 1.5vw, 2.5rem);
    color: var(--color-text);
    text-wrap: balance;
  }

  .latest__description {
    margin: 0.85rem 0 0;
    color: var(--color-muted);
    font-size: var(--step-0);
    line-height: 1.65;
    max-width: 54ch;
  }

  .latest__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.25rem, 2vw, 2rem);
    align-items: center;
  }

  .latest__cover-wrap {
    margin: 0;
    width: min(100%, 17rem);
    justify-self: start;
  }

  .latest__cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--aaaa-gold) 22%, transparent);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }

  .latest__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-width: 0;
  }

  .latest__track {
    margin: 0 0 var(--space-2xs);
    font-family: var(--aaaa-display);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    font-size: clamp(1.65rem, 1.1rem + 1.6vw, 2.5rem);
    color: var(--color-text);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .latest__meta {
    margin: 0;
    color: color-mix(in srgb, var(--color-text) 78%, var(--color-muted));
    font-size: var(--step-0);
    letter-spacing: 0.03em;
  }

  .latest__saga {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .latest__saga a {
    color: var(--aaaa-gold);
    text-decoration: none;
  }

  .latest__saga a:hover {
    color: var(--color-text);
  }

  .latest__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-sm);
  }

  .latest__actions .btn {
    min-height: 44px;
    padding: 0.8rem 1.25rem;
    font-size: 1rem;
    justify-content: center;
  }

  .latest__icon {
    display: inline-flex;
  }

  .latest__icon svg {
    width: 1rem;
    height: 1rem;
  }

  @media (min-width: 40rem) {
    .latest__grid {
      grid-template-columns: auto minmax(0, 1fr);
      max-width: 57rem;
    }

    .latest__cover-wrap {
      width: clamp(12rem, 21vw, 20rem);
    }

    .latest__info {
      max-width: 33rem;
    }
  }

  @media (max-width: 63.9375rem) {
    .latest__bg {
      inset-inline-start: 18%;
    }

    .latest__overlay {
      background:
        linear-gradient(to bottom, var(--aaaa-bg), transparent 12%, color-mix(in srgb, var(--aaaa-bg) 85%, transparent) 84%, color-mix(in srgb, var(--aaaa-bg) 95%, transparent)),
        linear-gradient(to right, var(--aaaa-bg), color-mix(in srgb, var(--aaaa-bg) 72%, transparent) 65%, color-mix(in srgb, var(--aaaa-bg) 30%, transparent));
    }
  }

  @media (max-width: 30rem) {
    .latest__actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
