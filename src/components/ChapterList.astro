---
import ChapterCard from './ChapterCard.astro';
import type { Chapter } from '../lib/cms/types';

interface Props {
  chapters: Chapter[];
  sagaId: string;
}

const { chapters, sagaId } = Astro.props;
---

{
  chapters.length === 0 ? (
    <p class="empty">No chapters are published yet.</p>
  ) : (
    <ol class="chapter-list">
      {chapters.map((chapter, index) => (
        <ChapterCard chapter={chapter} sagaId={sagaId} first={index === 0} />
      ))}
    </ol>
  )
}
