---
import { SITE } from '../lib/site';
import {
  archivesPath,
  homePath,
  isActive,
  musicPath,
  normalizePath,
  sagasPath,
  storiesPath,
  withBase,
} from '../lib/paths';

const current = Astro.url.pathname;
const isHome = normalizePath(current) === normalizePath(withBase(''));

const navItems = [
  { href: homePath(), label: 'Home', active: isHome },
  { href: sagasPath(), label: 'Sagas', active: isActive(current, sagasPath()) },
  { href: storiesPath(), label: 'Stories', active: isActive(current, storiesPath()) },
  { href: musicPath(), label: 'Music', active: isActive(current, musicPath()) },
  { href: archivesPath(), label: 'Archives', active: isActive(current, archivesPath()) },
];
---

<header class="site-header">
  <div class="container container--wide site-header__inner">
    <a class="brand" href={homePath()} aria-label={`${SITE.name} — home`}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">{SITE.name}</span>
    </a>

    <nav class="site-nav site-nav--desktop" aria-label="Primary">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={item.active ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="nav-drawer">
      <summary class="nav-drawer__toggle">
        <span class="nav-drawer__icon" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        <span class="visually-hidden">Menu</span>
      </summary>
      <nav class="nav-drawer__panel" aria-label="Primary">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={item.active ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const drawer = document.querySelector('.nav-drawer');
  if (drawer instanceof HTMLDetailsElement) {
    const toggle = drawer.querySelector('summary');
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && drawer.open) {
        drawer.open = false;
        toggle?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (drawer.open && target instanceof Node && !drawer.contains(target)) {
        drawer.open = false;
      }
    });
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        drawer.open = false;
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background-color: color-mix(in srgb, var(--color-bg) 76%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: 0.7rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand__mark {
    position: relative;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--color-accent) 80%, transparent);
    box-shadow: inset 0 0 0 0.28rem color-mix(in srgb, var(--color-primary) 45%, transparent);
  }

  .brand__mark::after {
    content: "";
    position: absolute;
    inset: 36%;
    border-radius: 50%;
    background: var(--color-text);
    opacity: 0.8;
  }

  .brand__name {
    font-weight: 800;
    font-size: 0.92rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  /* Desktop navigation */
  .site-nav--desktop {
    display: none;
  }

  .site-nav ul,
  .nav-drawer__panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-block;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 550;
    text-decoration: none;
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .site-nav a:hover {
    color: var(--color-text);
    background-color: color-mix(in srgb, var(--color-text) 7%, transparent);
  }

  .site-nav a[aria-current="page"] {
    color: var(--color-text);
    background-color: var(--color-primary-soft);
  }

  /* Mobile drawer */
  .nav-drawer {
    position: relative;
  }

  .nav-drawer__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    background-color: color-mix(in srgb, var(--color-text) 5%, transparent);
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .nav-drawer__toggle::-webkit-details-marker {
    display: none;
  }

  .nav-drawer__toggle:hover {
    border-color: var(--color-accent);
  }

  .nav-drawer__icon {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    width: 20px;
  }

  .nav-drawer__icon span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background-color: currentColor;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  .nav-drawer[open] .nav-drawer__icon span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-drawer[open] .nav-drawer__icon span:nth-child(2) {
    opacity: 0;
  }

  .nav-drawer[open] .nav-drawer__icon span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav-drawer__panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    z-index: 60;
    min-width: 13rem;
    padding: 0.45rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: color-mix(in srgb, var(--color-surface) 96%, transparent);
    box-shadow: var(--shadow-lg);
  }

  .nav-drawer__panel ul {
    display: grid;
    gap: 0.15rem;
  }

  .nav-drawer__panel a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: var(--step-0);
    text-decoration: none;
  }

  .nav-drawer__panel a:hover {
    background-color: color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  .nav-drawer__panel a[aria-current="page"] {
    color: var(--color-text);
    background-color: var(--color-primary-soft);
  }

  @media (min-width: 48rem) {
    .site-nav--desktop {
      display: block;
    }

    .site-nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 0.4rem;
    }

    .nav-drawer {
      display: none;
    }
  }
</style>
