---
import { render } from 'astro:content';
import ChapterComicReader from '../../../../components/ChapterComicReader.astro';
import ChapterEnding from '../../../../components/ChapterEnding.astro';
import welcomeWorldEndingArt from '../../../../assets/heroes/unrealyria-gateway-home-v1.png';
import ChapterMusicHub from '../../../../components/ChapterMusicHub.astro';
import ChapterOpening from '../../../../components/ChapterOpening.astro';
import StoryReader from '../../../../components/StoryReader.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { content } from '../../../../lib/cms';
import {
  chapterPath,
  chapterSlug,
  homePath,
  sagaPath,
  sagasPath,
} from '../../../../lib/paths';
import { SITE } from '../../../../lib/site';

export async function getStaticPaths() {
  const chapters = await content.getAllChapters();
  return chapters.map((chapter) => ({
    params: {
      saga: chapter.data.saga.id,
      chapter: chapterSlug(chapter.id),
    },
  }));
}

const { saga: sagaId, chapter: slug } = Astro.params;
const saga = sagaId ? await content.getSaga(sagaId) : undefined;
const chapter = sagaId && slug ? await content.getChapter(sagaId, slug) : undefined;

if (!saga || !chapter) {
  throw new Error(`Unknown or unpublished chapter: ${sagaId ?? '(none)'}/${slug ?? '(none)'}`);
}

const { Content } = await render(chapter);
// Editorial hold applies only to this chapter page; CMS entries and other routes stay available.
const isWelcomeWorld = saga.id === 'virtual-world' && chapter.id === 'virtual-world/01-welcome-world';
const storyFiles = isWelcomeWorld ? [] : await content.getStoryFiles(chapter.id);
const renderedStories = await Promise.all(
  storyFiles.map(async (file) => ({ file, Content: (await render(file)).Content })),
);

// Chapter-level theme track — only when the CMS explicitly links a music record
// to this chapter (never inferred from the saga).
const sagaMusic = await content.getMusic(saga.id);
const chapterTrack = sagaMusic.find((track) => track.data.chapter?.id === chapter.id);

const sagaChapters = await content.getChapters(saga.id);
const position = sagaChapters.findIndex((entry) => entry.id === chapter.id);
const previous = position > 0 ? sagaChapters[position - 1] : undefined;
const next =
  position >= 0 && position < sagaChapters.length - 1 ? sagaChapters[position + 1] : undefined;

const publishedAt = chapter.data.publishedAt;
const chapterNumber = String(chapter.data.number).padStart(2, '0');
const chapterUrl = chapterPath(saga.id, chapterSlug(chapter.id));

const breadcrumb = [
  { href: homePath(), label: 'Home' },
  { href: sagasPath(), label: 'Sagas' },
  { href: sagaPath(saga.id), label: saga.data.title },
  { label: `Chapter ${chapter.data.number}` },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Chapter',
  name: chapter.data.title,
  description: chapter.data.summary,
  position: chapter.data.number,
  isPartOf: { '@type': 'Book', name: saga.data.title },
  url: new URL(Astro.url.pathname, Astro.site ?? SITE.url).href,
};
---

<BaseLayout
  title={`Chapter ${chapterNumber}: ${chapter.data.title}`}
  description={chapter.data.summary}
  theme={saga.data.theme}
  image={chapter.data.image ?? saga.data.image}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <ChapterOpening
      eyebrow={`Chapter ${chapterNumber}`}
      title={chapter.data.title}
      summary={chapter.data.summary}
      sagaTitle={saga.data.title}
      publishedAt={publishedAt}
      image={chapter.data.image ?? saga.data.image}
      imageAlt={chapter.data.imageAlt ?? `Key artwork for Chapter ${chapterNumber}.`}
      breadcrumb={breadcrumb}
    />

    <div class="chapter-body">
      {
        chapterTrack && (
          <div class="container">
            <ChapterMusicHub track={chapterTrack} />
          </div>
        )
      }

      <div class="container" id={isWelcomeWorld ? 'chapter-comic' : undefined}>
        <ChapterComicReader
          srcDir={`/images/sagas/${saga.id}/chapters/${chapterSlug(chapter.id)}/pages`}
          label={chapter.data.title}
        />
      </div>

      {isWelcomeWorld ? (
        <ChapterEnding
          chapterTitle={chapter.data.title}
          chapterNumber={chapterNumber}
          chapterUrl={chapterUrl}
          sagaTitle={saga.data.title}
          sagaUrl={sagaPath(saga.id)}
          artwork={welcomeWorldEndingArt}
          srcDir={`/images/sagas/${saga.id}/chapters/${chapterSlug(chapter.id)}/pages`}
          readerId="chapter-comic"
        />
      ) : (<Fragment>
      <div class="container">
        <section class="chapter-narrative" aria-labelledby="chapter-narrative-heading">
          <h2 id="chapter-narrative-heading" class="reader chapter-narrative__heading">Chapter narrative</h2>
          <StoryReader panels={chapter.data.panels}>
            <Content />
          </StoryReader>
        </section>
      </div>

      {
        renderedStories.length > 0 && (
          <div class="container">
            <section class="story reader" aria-labelledby="story-heading">
              <h2 id="story-heading" class="story__heading">Story Files</h2>
              {renderedStories.map(({ file, Content: StoryContent }) => (
                <article class="story__item">
                  <h3 class="story__title display">{file.data.title}</h3>
                  <div class="prose story__body">
                    <StoryContent />
                  </div>
                </article>
              ))}
            </section>
          </div>
        )
      }

      <div class="container">
        <div class="reader chapter-end">
          <nav class="chapter-nav" aria-label="Chapter navigation">
            {
              previous ? (
                <a
                  class="chapter-nav__link"
                  href={chapterPath(saga.id, chapterSlug(previous.id))}
                  rel="prev"
                >
                  <span class="chapter-nav__dir">← Previous</span>
                  <span class="chapter-nav__label">
                    Chapter {previous.data.number}: {previous.data.title}
                  </span>
                </a>
              ) : (
                <span class="chapter-nav__spacer" aria-hidden="true" />
              )
            }
            <a class="btn btn--ghost chapter-nav__back" href={sagaPath(saga.id)}>Back to Saga</a>
            {
              next ? (
                <a
                  class="chapter-nav__link chapter-nav__link--next"
                  href={chapterPath(saga.id, chapterSlug(next.id))}
                  rel="next"
                >
                  <span class="chapter-nav__dir">Next →</span>
                  <span class="chapter-nav__label">
                    Chapter {next.data.number}: {next.data.title}
                  </span>
                </a>
              ) : (
                <span class="chapter-nav__spacer" aria-hidden="true" />
              )
            }
          </nav>

          <p class="meta reader__foot">
            <a href={chapterUrl}>Permalink</a>
          </p>
        </div>
      </div>
      </Fragment>)}
    </div>
  </article>
</BaseLayout>

<style>
  #chapter-comic { scroll-margin-top: 6rem; }
  /* Single vertical rhythm for the whole chapter body — one gap between hero,
     music hub, reading and ending (no duplicated margins). */
  .chapter-body {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 1.75rem + 3vw, 4rem);
    padding-block: clamp(2.75rem, 2rem + 3vw, 4rem) clamp(3rem, 2.5rem + 3vw, 5rem);
  }

  .reader {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .chapter-narrative {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .chapter-narrative__heading {
    margin-block: 0 var(--space-md);
    font-size: var(--step-2);
  }

  /* --- Story Files: distinct editorial blocks ----------------------------- */
  .story {
    padding-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-top: 1px solid var(--color-border);
  }

  .story__heading {
    margin: 0 0 var(--space-md);
    font-size: var(--step-2);
  }

  .story__item {
    padding: clamp(1.25rem, 1rem + 1.5vw, 1.75rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
  }

  .story__item + .story__item {
    margin-top: var(--space-md);
  }

  .story__title {
    margin: 0 0 var(--space-sm);
    font-size: var(--step-1);
    color: var(--color-primary);
  }

  .story__body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* --- Chapter ending ----------------------------------------------------- */
  .chapter-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: var(--space-sm);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .chapter-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .chapter-nav__link:hover {
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    transform: translateY(-2px);
  }

  .chapter-nav__link--next {
    text-align: right;
  }

  .chapter-nav__dir {
    font-size: var(--step--1);
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .chapter-nav__label {
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  .chapter-nav__back {
    align-self: center;
    justify-self: center;
    white-space: nowrap;
  }

  .reader__foot {
    margin-top: var(--space-md);
    text-align: center;
  }

  @media (max-width: 40rem) {
    .chapter-body {
      gap: clamp(2rem, 1.5rem + 3vw, 3rem);
    }

    .chapter-nav {
      grid-template-columns: minmax(0, 1fr);
    }

    .chapter-nav__spacer {
      display: none;
    }

    .chapter-nav__link--next {
      text-align: left;
    }

    .chapter-nav__back {
      justify-self: stretch;
      text-align: center;
      justify-content: center;
    }
  }
</style>
