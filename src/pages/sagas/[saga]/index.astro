---
import ChapterList from '../../../components/ChapterList.astro';
import Hero from '../../../components/Hero.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { content } from '../../../lib/cms';
import { archivesPath, chapterPath, chapterSlug, musicPath } from '../../../lib/paths';
import { sagaKeyArt } from '../../../lib/saga-art';
import { SITE } from '../../../lib/site';

export async function getStaticPaths() {
  const sagas = await content.getSagas();
  return sagas.map((saga) => ({ params: { saga: saga.id } }));
}

const { saga: sagaId } = Astro.params;
const saga = sagaId ? await content.getSaga(sagaId) : undefined;

if (!saga) {
  throw new Error(`Unknown or unpublished saga: ${sagaId ?? '(none)'}`);
}

const chapters = await content.getChapters(saga.id);
const lore = await content.getLore(saga.id);
const music = await content.getMusic(saga.id);
const storyFiles = await content.getStoryFilesBySaga(saga.id);

const firstChapter = chapters[0];
const track = music[0];
const chapterIndex = new Map(chapters.map((chapter) => [chapter.id, chapter]));

const heroImageAlt = saga.data.imageAlt ?? `Key visual for ${saga.data.title}.`;
const keyArt = sagaKeyArt(saga.id);
const heroAlt = keyArt?.alt ?? heroImageAlt;

const extras = [
  ...storyFiles.map((file) => {
    const chapter = chapterIndex.get(file.data.chapter.id);
    return {
      key: `story-${file.id}`,
      kind: 'Story file',
      title: file.data.title,
      description: file.data.summary,
      href: chapter ? chapterPath(saga.id, chapterSlug(chapter.id)) : undefined,
    };
  }),
  ...music.map((track) => ({
    key: `music-${track.id}`,
    kind: 'Track',
    title: track.data.title,
    description: track.data.credits,
    href: musicPath(),
  })),
  ...lore.map((entry) => ({
    key: `lore-${entry.id}`,
    kind: entry.data.category,
    title: entry.data.title,
    description: entry.data.summary,
    href: archivesPath(),
  })),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: saga.data.title,
  description: saga.data.summary,
  url: new URL(Astro.url.pathname, Astro.site ?? SITE.url).href,
};
---

<BaseLayout
  title={saga.data.title}
  description={saga.data.summary}
  theme={saga.data.theme}
  image={saga.data.image}
  type="book"
  jsonLd={jsonLd}
>
  <Hero
    variant="panorama"
    theme={saga.data.theme}
    eyebrow="Saga"
    title={saga.data.title}
    tagline={saga.data.tagline}
    image={keyArt?.image ?? saga.data.image}
    imageMobile={keyArt?.imageMobile}
    imageAlt={heroAlt}
    align={keyArt ? 'end' : undefined}
    stacked={Boolean(keyArt)}
  >
    <Fragment slot="actions">
      {
        firstChapter && (
          <a class="btn btn--primary btn--lg" href={chapterPath(saga.id, chapterSlug(firstChapter.id))}>
            Start Chapter {String(firstChapter.data.number).padStart(2, '0')}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        )
      }
    </Fragment>
  </Hero>

  {/* Immersive synopsis — continues the hero, no panel, editorial type. */}
  <section class="saga-intro" aria-labelledby="synopsis-heading">
    <div class="container">
      <h2 id="synopsis-heading" class="eyebrow">Synopsis</h2>
      <p class="saga-intro__lede">{saga.data.summary}</p>
      {
        saga.data.tags.length > 0 && (
          <ul class="tag-list saga-intro__tags" aria-label="Tags">
            {saga.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  {
    chapters.length > 1 ? (
      <section class="section" aria-labelledby="chapters-heading">
        <div class="container">
          <SectionHeading eyebrow="Story" title="Chapter progression" id="chapters-heading" />
          <ChapterList chapters={chapters} sagaId={saga.id} />
        </div>
      </section>
    ) : firstChapter ? (
      <section class="chapter-feature" aria-labelledby="begin-heading">
        <div class="container">
          <div class="chapter-feature__inner">
            <figure class="chapter-feature__art">
              <img
                src={firstChapter.data.image}
                alt={
                  firstChapter.data.imageAlt ??
                  `Key visual for Chapter ${String(firstChapter.data.number).padStart(2, '0')}.`
                }
                width="1254"
                height="1254"
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div class="chapter-feature__copy">
              <p class="eyebrow">Chapter {String(firstChapter.data.number).padStart(2, '0')}</p>
              <h2 id="begin-heading" class="chapter-feature__title display">
                {firstChapter.data.title}
              </h2>
              <p class="chapter-feature__summary">{firstChapter.data.summary}</p>
              <div class="chapter-feature__actions">
                <a
                  class="btn btn--primary btn--lg"
                  href={chapterPath(saga.id, chapterSlug(firstChapter.id))}
                >
                  Start reading <span class="btn__arrow" aria-hidden="true">→</span>
                </a>
              </div>
              {
                track && (
                  <p class="chapter-feature__soundtrack">
                    Official soundtrack: <strong>{track.data.title}</strong>
                    {track.data.youtubeUrl && (
                      <>
                        {' — '}
                        <a href={track.data.youtubeUrl} target="_blank" rel="noopener noreferrer">
                          Watch on YouTube
                        </a>
                      </>
                    )}
                  </p>
                )
              }
            </div>
          </div>
        </div>
      </section>
    ) : null
  }

  {
    extras.length > 0 && (
      <section class="section" aria-labelledby="more-heading">
        <div class="container">
          <SectionHeading
            eyebrow="More from this saga"
            title="Lore, music & story files"
            id="more-heading"
          />
          <ul class="saga-index">
            {extras.map((item) => (
              <li class="saga-index__row">
                {item.href ? (
                  <a class="saga-index__link" href={item.href}>
                    <span class="saga-index__text">
                      <span class="saga-index__kind">{item.kind}</span>
                      <span class="saga-index__title display">{item.title}</span>
                      {item.description && <span class="saga-index__desc">{item.description}</span>}
                    </span>
                    <span class="saga-index__arrow" aria-hidden="true">→</span>
                  </a>
                ) : (
                  <div class="saga-index__static">
                    <span class="saga-index__text">
                      <span class="saga-index__kind">{item.kind}</span>
                      <span class="saga-index__title display">{item.title}</span>
                      {item.description && <span class="saga-index__desc">{item.description}</span>}
                    </span>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* --- Immersive synopsis: overlaps the hero, no panel ------------------- */
  .saga-intro {
    position: relative;
    z-index: 1;
    margin-top: clamp(-4rem, -4vw, -1.5rem);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 5.5rem) clamp(2rem, 1.5rem + 3vw, 3.5rem);
    background: linear-gradient(
      to bottom,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 55%, transparent) 42%,
      transparent 100%
    );
  }

  .saga-intro__lede {
    margin: var(--space-sm) 0 0;
    max-width: 36ch;
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: -0.01em;
    font-size: var(--step-2);
    color: color-mix(in srgb, var(--color-text) 90%, var(--color-muted));
    text-wrap: pretty;
  }

  .saga-intro__tags {
    margin-top: var(--space-lg);
  }

  /* When the hero stacks its copy below the artwork (below the large-desktop
     breakpoint), the synopsis no longer overlaps an image — drop the negative
     pull so it starts cleanly after the copy. */
  @media (max-width: 79.9375rem) {
    .saga-intro {
      margin-top: 0;
    }
  }

  /* --- Chapter 01: cinematic narrative feature -------------------------- */
  .chapter-feature {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem);
  }

  .chapter-feature::before {
    content: "";
    position: absolute;
    inset: -20% 30% auto;
    height: 170%;
    z-index: 0;
    background:
      radial-gradient(
        40% 50% at 30% 35%,
        color-mix(in srgb, var(--color-primary) 20%, transparent),
        transparent 62%
      ),
      radial-gradient(
        40% 50% at 80% 75%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 60%
      );
    pointer-events: none;
  }

  .chapter-feature__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    align-items: center;
  }

  .chapter-feature__art {
    margin: 0;
    width: min(100%, 26rem);
    justify-self: center;
  }

  .chapter-feature__art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--color-accent) 26%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .chapter-feature__copy {
    max-width: 40rem;
  }

  .chapter-feature__title {
    margin: 0 0 var(--space-sm);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    text-wrap: balance;
  }

  .chapter-feature__summary {
    margin: 0;
    max-width: 46ch;
    color: color-mix(in srgb, var(--color-text) 82%, var(--color-muted));
    font-size: var(--step-1);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .chapter-feature__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .chapter-feature__soundtrack {
    margin: var(--space-md) 0 0;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .chapter-feature__soundtrack strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .chapter-feature__soundtrack a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .chapter-feature__soundtrack a:hover {
    color: var(--color-primary);
  }

  @media (min-width: 55rem) {
    .chapter-feature__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .chapter-feature__art {
      width: clamp(22rem, 26vw, 28rem);
      justify-self: start;
    }
  }

  /* --- More from this saga: editorial index ----------------------------- */
  .saga-index {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .saga-index__row {
    border-bottom: 1px solid var(--color-border);
  }

  .saga-index__link,
  .saga-index__static {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-block: clamp(1rem, 0.7rem + 1vw, 1.5rem);
    color: inherit;
    text-decoration: none;
  }

  .saga-index__link {
    transition: color var(--dur) var(--ease);
  }

  .saga-index__link:hover {
    color: var(--color-accent);
  }

  .saga-index__text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .saga-index__kind {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .saga-index__title {
    font-size: var(--step-2);
  }

  .saga-index__desc {
    color: var(--color-muted);
    font-size: var(--step--1);
    max-width: 60ch;
  }

  .saga-index__arrow {
    flex: none;
    color: var(--color-accent);
    transition: transform var(--dur) var(--ease);
  }

  .saga-index__link:hover .saga-index__arrow {
    transform: translateX(4px);
  }
</style>
