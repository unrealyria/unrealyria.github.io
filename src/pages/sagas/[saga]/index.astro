---
import ChapterList from '../../../components/ChapterList.astro';
import ContentTeaser from '../../../components/ContentTeaser.astro';
import Hero from '../../../components/Hero.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { content } from '../../../lib/cms';
import { archivesPath, chapterPath, chapterSlug, musicPath } from '../../../lib/paths';
import { SITE } from '../../../lib/site';

export async function getStaticPaths() {
  const sagas = await content.getSagas();
  return sagas.map((saga) => ({ params: { saga: saga.id } }));
}

const { saga: sagaId } = Astro.params;
const saga = sagaId ? await content.getSaga(sagaId) : undefined;

if (!saga) {
  throw new Error(`Unknown or unpublished saga: ${sagaId ?? '(none)'}`);
}

const chapters = await content.getChapters(saga.id);
const lore = await content.getLore(saga.id);
const music = await content.getMusic(saga.id);
const storyFiles = await content.getStoryFilesBySaga(saga.id);

const firstChapter = chapters[0];
const chapterIndex = new Map(chapters.map((chapter) => [chapter.id, chapter]));

const heroImageAlt = saga.data.imageAlt ?? `Key visual for ${saga.data.title}.`;

const extras = [
  ...storyFiles.map((file) => {
    const chapter = chapterIndex.get(file.data.chapter.id);
    return {
      key: `story-${file.id}`,
      kind: 'Story file',
      title: file.data.title,
      description: file.data.summary,
      href: chapter ? chapterPath(saga.id, chapterSlug(chapter.id)) : undefined,
    };
  }),
  ...music.map((track) => ({
    key: `music-${track.id}`,
    kind: 'Track',
    title: track.data.title,
    description: track.data.credits,
    href: musicPath(),
  })),
  ...lore.map((entry) => ({
    key: `lore-${entry.id}`,
    kind: entry.data.category,
    title: entry.data.title,
    description: entry.data.summary,
    href: archivesPath(),
  })),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: saga.data.title,
  description: saga.data.summary,
  url: new URL(Astro.url.pathname, Astro.site ?? SITE.url).href,
};
---

<BaseLayout
  title={saga.data.title}
  description={saga.data.summary}
  theme={saga.data.theme}
  image={saga.data.image}
  type="book"
  jsonLd={jsonLd}
>
  <Hero
    variant="panorama"
    theme={saga.data.theme}
    eyebrow="Saga"
    title={saga.data.title}
    image={saga.data.image}
    imageAlt={heroImageAlt}
  >
    <Fragment slot="actions">
      {
        firstChapter && (
          <a class="btn btn--primary btn--lg" href={chapterPath(saga.id, chapterSlug(firstChapter.id))}>
            Start Chapter {String(firstChapter.data.number).padStart(2, '0')}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        )
      }
    </Fragment>
  </Hero>

  <section class="section section--tight" aria-labelledby="synopsis-heading">
    <div class="container">
      <div class="synopsis">
        <div>
          <h2 id="synopsis-heading" class="eyebrow">Synopsis</h2>
          <p class="lede">{saga.data.summary}</p>
        </div>
        {
          saga.data.tags.length > 0 && (
            <ul class="tag-list" aria-label="Tags">
              {saga.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="chapters-heading">
    <div class="container">
      <SectionHeading eyebrow="Story" title="Chapter progression" id="chapters-heading" />
      <ChapterList chapters={chapters} sagaId={saga.id} />
    </div>
  </section>

  {
    extras.length > 0 && (
      <section class="section section--tight" aria-labelledby="more-heading">
        <div class="container">
          <SectionHeading
            eyebrow="More from this saga"
            title="Lore, music & story files"
            id="more-heading"
          />
          <ul class="grid-teasers">
            {extras.map((item) => (
              <ContentTeaser
                kind={item.kind}
                title={item.title}
                description={item.description}
                href={item.href}
              />
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .synopsis {
    display: grid;
    gap: var(--space-md);
    align-items: start;
    max-width: 60rem;
  }

  @media (min-width: 55rem) {
    .synopsis {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
