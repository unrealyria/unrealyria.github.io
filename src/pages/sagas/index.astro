---
import sagasHero from '../../assets/heroes/unrealyria-sagas-hero-v1.png';
import EmptyState from '../../components/EmptyState.astro';
import Hero from '../../components/Hero.astro';
import SagaCard from '../../components/SagaCard.astro';
import SagaFeature from '../../components/SagaFeature.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { content } from '../../lib/cms';

const sagas = await content.getSagas();
const single = sagas.length === 1 ? sagas[0] : undefined;
const singleChapter = single ? (await content.getChapters(single.id))[0] : undefined;
---

<BaseLayout
  title="Sagas"
  description="Browse every published saga in the UnreaLyria universe."
>
  <Hero
    variant="cinematic"
    eyebrow="The library"
    title="Sagas"
    tagline="Explore the stories, worlds and adventures of UnreaLyria. Every saga opens a new chapter of the universe."
    image={sagasHero}
    imageAlt="Lyria at a desk surrounded by saga artwork, notes and maps pinned to a corkboard."
    align="start"
    focus="60% 28%"
    focusMobile="72% 20%"
    stacked
  />

  {
    sagas.length === 0 ? (
      <section class="section section--tight">
        <div class="container">
          <EmptyState
            kind="sagas"
            title="No sagas published yet"
            description="The first saga is being prepared. Check back once it clears review."
          />
        </div>
      </section>
    ) : single ? (
      <SagaFeature
        saga={single}
        chapter={singleChapter}
        eyebrow="Now showing"
        summary="One night in the real world. Years of adventures beyond reality. Follow LYRIA into a virtual world where every choice carries a consequence."
      />
    ) : (
      <section class="section section--tight">
        <div class="container">
          <ul class="grid-cards">
            {sagas.map((saga) => (
              <SagaCard saga={saga} />
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
