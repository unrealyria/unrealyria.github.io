---
import EmptyState from '../../components/EmptyState.astro';
import SagaCard from '../../components/SagaCard.astro';
import SagaFeature from '../../components/SagaFeature.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { content } from '../../lib/cms';

const sagas = await content.getSagas();
const single = sagas.length === 1 ? sagas[0] : undefined;
const singleChapter = single ? (await content.getChapters(single.id))[0] : undefined;
---

<BaseLayout
  title="Sagas"
  description="Browse every published saga in the UnreaLyria universe."
>
  <section class="section section--tight">
    <div class="container">
      <header class="page-head">
        <p class="eyebrow">The library</p>
        <h1 class="page-head__title display">Sagas</h1>
        <p class="lede">
          Every published saga in the UnreaLyria universe. New sagas are added as they are approved
          for release.
        </p>
      </header>
    </div>
  </section>

  {
    sagas.length === 0 ? (
      <section class="section section--tight">
        <div class="container">
          <EmptyState
            kind="sagas"
            title="No sagas published yet"
            description="The first saga is being prepared. Check back once it clears review."
          />
        </div>
      </section>
    ) : single ? (
      <SagaFeature saga={single} chapter={singleChapter} eyebrow="Now showing" />
    ) : (
      <section class="section section--tight">
        <div class="container">
          <ul class="grid-cards">
            {sagas.map((saga) => (
              <SagaCard saga={saga} />
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
