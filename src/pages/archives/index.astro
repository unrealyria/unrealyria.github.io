---
import archivesHero from '../../assets/heroes/unrealyria-archives-hero-v1.png';
import ContentTeaser from '../../components/ContentTeaser.astro';
import EmptyState from '../../components/EmptyState.astro';
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { content } from '../../lib/cms';
import { sagaPath } from '../../lib/paths';

const sagas = await content.getSagas();
const sagaIndex = new Map(sagas.map((saga) => [saga.id, saga]));
const lore = await content.getAllLore();

const items = lore.map((entry) => {
  const saga = entry.data.saga ? sagaIndex.get(entry.data.saga.id) : undefined;
  const category = entry.data.category;
  return {
    key: entry.id,
    kind: category.charAt(0).toUpperCase() + category.slice(1),
    title: entry.data.title,
    description: entry.data.summary,
    meta: saga?.data.title,
    href: saga ? sagaPath(saga.id) : undefined,
  };
});
---

<BaseLayout
  title="Archives"
  description="Lore entries from the published sagas of the UnreaLyria universe."
>
  <Hero
    variant="cinematic"
    eyebrow="Lore"
    title="Archives"
    tagline="Published lore entries from across the universe, grouped by saga. More entries are added as they are approved."
    image={archivesHero}
    imageAlt="Lyria sorting photographs and folders in an archive room lined with labelled boxes."
    align="start"
    focus="52% 26%"
    focusMobile="50% 24%"
  />

  <section class="section">
    <div class="container">
      {
        items.length === 0 ? (
          <EmptyState
            kind="archives"
            title="No lore entries yet"
            description="Archive entries appear here as the universe's world, characters and terms are documented."
          />
        ) : (
          <ul class="grid-teasers">
            {items.map((item) => (
              <ContentTeaser
                kind={item.kind}
                title={item.title}
                description={item.description}
                meta={item.meta}
                href={item.href}
              />
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
