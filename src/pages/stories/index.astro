---
import storiesHero from '../../assets/heroes/unrealyria-stories-hero-v1.png';
import ContentTeaser from '../../components/ContentTeaser.astro';
import EmptyState from '../../components/EmptyState.astro';
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { content } from '../../lib/cms';
import { chapterPath, chapterSlug } from '../../lib/paths';

const chapters = await content.getAllChapters();
const chapterIndex = new Map(chapters.map((chapter) => [chapter.id, chapter]));
const storyFiles = await content.getAllStoryFiles();

const items = storyFiles.map((file) => {
  const chapter = chapterIndex.get(file.data.chapter.id);
  return {
    key: file.id,
    kind: chapter ? `Chapter ${chapter.data.number} · ${chapter.data.title}` : 'Story file',
    title: file.data.title,
    description: file.data.summary,
    href: chapter ? chapterPath(chapter.data.saga.id, chapterSlug(chapter.id)) : undefined,
  };
});
---

<BaseLayout
  title="Stories"
  description="Story files that accompany the published chapters of the UnreaLyria sagas."
>
  <Hero
    variant="cinematic"
    eyebrow="Story files"
    title="Stories"
    tagline="Short story files that accompany the published chapters. Each links back to the chapter it belongs to."
    image={storiesHero}
    imageAlt="Lyria writing in a notebook at a café window at night, the rain-streaked city glowing behind her."
    align="start"
    focus="58% 26%"
    focusMobile="56% 22%"
  />

  <section class="section">
    <div class="container">
      {
        items.length === 0 ? (
          <EmptyState
            kind="stories"
            title="No story files yet"
            description="Companion scenes appear here once a chapter and its story files are published."
          />
        ) : (
          <ul class="grid-teasers">
            {items.map((item) => (
              <ContentTeaser
                kind={item.kind}
                title={item.title}
                description={item.description}
                href={item.href}
              />
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
