---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homePath, sagasPath } from '../lib/paths';
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for does not exist."
  noindex
>
  <section class="section">
    <div class="container">
      <header class="page-head">
        <p class="eyebrow">Error 404</p>
        <h1 class="page-head__title display">This page is not part of the world.</h1>
        <p class="lede">
          The page you requested could not be found. It may be unpublished, moved, or never have
          existed.
        </p>
      </header>
      <div class="actions">
        <a class="btn btn--primary" href={homePath()}>Back to home</a>
        <a class="btn btn--ghost" href={sagasPath()}>Browse sagas</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
